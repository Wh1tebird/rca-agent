# Optional provider credentials. Keep real values in a local, ignored .env file.
DEEPSEEK_API_KEY=
RCA_LOCAL_API_KEY=

# Optional local RCA100 observation directory. RCA100 is never bundled here.
RCA100_CASES_ROOT=/absolute/path/to/RCA100/cases

# Optional local model settings.
RCA_LOCAL_BASE_URL=http://127.0.0.1:11025/v1
RCA_LOCAL_MODEL=Qwen3-30B-A3B-Thinking-2507
RCA_LOCAL_ALLOW_INSECURE_HTTP=false
